# Example Environment file

## Environment variables for API Server
# Port for server to listen on
PORT=8080

## Environment variables for connecting to PostgreSQL

# User and password to connect to database as
# Uncomment and set to appropriate user and password
# DB_USER="<DB_USER>"
# DB_PASS="<DB_PASS>"

# Host to connect to database on
# Uncomment and set to database host
# DB_HOST="<DB_HOST>"

# Port to connect to database on
# Uncomment and set to database port
# DB_PORT=<DB_PORT>

# Name of database to connect to
# Uncomment and set to database
# DB_NAME="<DB_NAME>"

## Environment variables for Testcontainers and Docker
## Used for testing only
## See https://github.com/testcontainers/testcontainers-node/blob/main/docs/configuration.md for all environment variables used by Testcontainers and Docker

# Uncomment and set to the URL of the Docker daemon
# DOCKER_HOST=""

# Docker image to use for PostgreSQL
TEST_POSTGRES_IMAGE="postgres:16"
